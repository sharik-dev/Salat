    {
      "id": "istiftah",
      "order": 3,
      "image": "pos_qiyam",
      "posture": "standing",
      "repetitions": 1,
      "spoken": true,
      "arabic": "سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ، وَتَبَارَكَ اسْمُكَ، وَتَعَالَى جَدُّكَ، وَلَا إِلَهَ غَيْرُكَ"
    },
    {
      "id": "taawwudh",
      "order": 4,
      "image": "pos_qiyam",
      "posture": "standing",
      "repetitions": 1,
      "spoken": true,
      "arabic": "أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ"
    },
    {
      "id": "fatiha",
      "order": 5,
      "image": "pos_qiyam",
      "posture": "standing",
      "repetitions": 1,
      "spoken": true,
      "arabic": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ\nالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ\nالرَّحْمَٰنِ الرَّحِيمِ\nمَالِكِ يَوْمِ الدِّينِ\nإِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ\nاهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ\nصِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ"
    },
    {
      "id": "surah",
      "order": 6,
      "image": "pos_qiyam",
      "posture": "standing",
      "repetitions": 1,
      "spoken": true,
      "arabic": "قُلْ هُوَ اللَّهُ أَحَدٌ\nاللَّهُ الصَّمَدُ\nلَمْ يَلِدْ وَلَمْ يُولَدْ\nوَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ"
    },
    {
      "id": "ruku",
      "order": 7,
      "image": "pos_ruku",
      "posture": "bowing",
      "repetitions": 3,
      "spoken": true,
      "arabic": "سُبْحَانَ رَبِّيَ الْعَظِيمِ"
    },
    {
      "id": "itidal",
      "order": 8,
      "image": "pos_itidal",
      "posture": "standing",
      "repetitions": 1,
      "spoken": true,
      "arabic": "سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ\nرَبَّنَا وَلَكَ الْحَمْدُ"
    },
    {
      "id": "sujud",
      "order": 9,
      "image": "pos_sujud",
      "posture": "prostrating",
      "repetitions": 3,
      "spoken": true,
      "arabic": "سُبْحَانَ رَبِّيَ الْأَعْلَى"
    },
    {
      "id": "jalsa",
      "order": 10,
      "image": "pos_jalsa",
      "posture": "sitting",
      "repetitions": 1,
      "spoken": true,
      "arabic": "رَبِّ اغْفِرْ لِي"
    },
    {
      "id": "sujud2",
      "order": 11,
      "image": "pos_sujud",
      "posture": "prostrating",
      "repetitions": 3,
      "spoken": true,
      "arabic": "سُبْحَانَ رَبِّيَ الْأَعْلَى"
    },
    {
      "id": "tashahhud",
      "order": 12,
      "image": "pos_tashahhud",
      "posture": "sitting",
      "repetitions": 1,
      "spoken": true,
      "arabic": "التَّحِيَّاتُ لِلَّهِ وَالصَّلَوَاتُ وَالطَّيِّبَاتُ\nالسَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ\nالسَّلَامُ عَلَيْنَا وَعَلَى عِبَادِ اللَّهِ الصَّالِحِينَ\nأَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ"
    },
    {
      "id": "salawat",
      "order": 13,
      "image": "pos_tashahhud_index",
      "posture": "sitting",
      "repetitions": 1,
      "spoken": true,
      "arabic": "اللَّهُمَّ صَلِّ عَلَى مُحَمَّدٍ وَعَلَى آلِ مُحَمَّدٍ، كَمَا صَلَّيْتَ عَلَى إِبْرَاهِيمَ وَعَلَى آلِ إِبْرَاهِيمَ، إِنَّكَ حَمِيدٌ مَجِيدٌ\nاللَّهُمَّ بَارِكْ عَلَى مُحَمَّدٍ وَعَلَى آلِ مُحَمَّدٍ، كَمَا بَارَكْتَ عَلَى إِبْرَاهِيمَ وَعَلَى آلِ إِبْرَاهِيمَ، إِنَّكَ حَمِيدٌ مَجِيدٌ"
    },
    {
      "id": "taslim",
      "order": 14,
      "image": "pos_salam",
      "posture": "sitting",
      "repetitions": 2,
      "spoken": true,
      "arabic": "السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ"
    }
